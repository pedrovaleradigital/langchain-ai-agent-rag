# ============================================
# OpenAI API
# ============================================
OPENAI_API_KEY="sk-proj-YOUR_OPENAI_API_KEY_HERE"

# ============================================
# CONFIGURACIÓN DE PROMPT
# ============================================
# Opciones: "filosofo" o "conversacional"
PROMPT_TYPE="conversacional"

# ============================================
# Chatwoot (Plataforma de mensajería)
# ============================================
CHATWOOT_BASE_URL="https://your-chatwoot-instance.com/"
CHATWOOT_ACCOUNT_ID="1"
CHATWOOT_API_ACCESS_TOKEN="YOUR_CHATWOOT_API_TOKEN"
#CHATWOOT_INBOX_ID="1"

# ============================================
# Supabase (Base de datos + Vector Store)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_KEY_HERE

# ============================================
# Google Services
# ============================================
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID_HERE
GOOGLE_SHEET_NAME=Interesados
GOOGLE_SERVICE_ACCOUNT_PATH=/path/to/your/service-account-credentials.json

APP_PASSWORD_GMAIL=YOUR_GMAIL_APP_PASSWORD
EMAIL_REMITENTE=your-email@gmail.com

# ============================================
# REDIS - Configuración para concatenación de mensajes
# ============================================
REDIS_HOST=redis-xxxxx.c16.us-east-1-3.ec2.cloud.redislabs.com
REDIS_PORT=13530
REDIS_DB=0
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE
# Tiempo de espera (en segundos) para acumular mensajes antes de procesarlos
MESSAGE_ACCUMULATION_TTL=5
